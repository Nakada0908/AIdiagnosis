    - {fileID: 0}
    storyText: "\u304A\u5BA2\u3055\u3093\u304B\u3089\u3001\n\u3053\u3063\u3061\u306B\u975E\u304C\u306A\u3044\u7406\u4E0D\u5C3D\u306A\u30A4\u30C1\u30E3\u30E2\u30F3\uFF08\u30AF\u30EC\u30FC\u30E0\uFF09\u3092\u3064\u3051\u3089\u308C\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u8077\u5834\u3002\u3053\u3061\u3089\u306B\u975E\u304C\u306A\u3044\u7406\u4E0D\u5C3D\u306A\u30AF\u30EC\u30FC\u30E0\u3092\u5BA2\u304B\u3089\u3064\u3051\u3089\u308C\u305F\u5834\u9762"
      question1: "\u300C\u5E97\u306E\u30EB\u30FC\u30EB\u3067\u3059\u306E\u3067\u300D\u3068\u51B7\u305F\u304F\u65AD\u308A\u3001\u6BC5\u7136\u3068\u5BFE\u5FDC\u3059\u308B"
      question2: "\u3068\u308A\u3042\u3048\u305A\u6012\u308A\u3092\u93AE\u3081\u308B\u305F\u3081\u306B\u3001\u3072\u305F\u3059\u3089\u982D\u3092\u4E0B\u3052\u3066\u8B1D\u308B"
      question3: "\u81EA\u5206\u306E\u624B\u306B\u8CA0\u3048\u306A\u3044\u306E\u3067\u3001\u3059\u3050\u306B\u8CAC\u4EFB\u8005\u3084\u5148\u8F29\u3092\u547C\u3076"

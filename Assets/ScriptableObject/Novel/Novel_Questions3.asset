    storyText: "\u5E97\u9577\uFF08\u4E0A\u53F8\uFF09\u304B\u3089\u3001\u660E\u3089\u304B\u306B\u52B9\u7387\u306E\u60AA\u3044\u9762\u5012\u306A\u3084\u308A\u65B9\u3092\u6307\u793A\u3055\u308C\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u8077\u5834\u3002\u4E0A\u53F8\u304B\u3089\u660E\u3089\u304B\u306B\u52B9\u7387\u306E\u60AA\u3044\u3084\u308A\u65B9\u3092\u6307\u793A\u3055\u308C\u305F\u5834\u9762"
      question1: "\u300C\u3053\u3063\u3061\u306E\u3084\u308A\u65B9\u306E\u65B9\u304C\u7D76\u5BFE\u65E9\u3044\u3067\u3059\u3088\u300D\n\u3068\u8AD6\u7406\u7684\u306B\u63D0\u6848\u3059\u308B"
      question2: "\u8077\u5834\u306E\u4EBA\u9593\u95A2\u4FC2\u3092\u60AA\u304F\u3057\u305F\u304F\u306A\u3044\u306E\u3067\u3001\n\u8A00\u308F\u308C\u305F\u901A\u308A\u306B\u3084\u3063\u3066\u304A\u304F"
      question3: "\u3084\u3063\u3066\u308B\u30D5\u30EA\u3060\u3051\u3057\u3066\u3001\n\u5E97\u9577\u306E\u898B\u3066\u3044\u306A\u3044\u3068\u3053\u308D\u3067\u52DD\u624B\u306B\u52B9\u7387\u826F\u3044\u3084\u308A\u65B9\u3067\u3084\u308B"
      choiceNum: 0
      answer: 

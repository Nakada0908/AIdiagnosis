      situation: "\u8077\u5834\u3002\u5BA2\u306B\u306F\u30D0\u30EC\u306A\u3044\u304B\u3089\u54C1\u8CEA\u3092\u843D\u3068\u3057\u3066\u5B89\u304F\u4F5C\u308D\u3046\u3001\u3068\u4F1A\u793E\u306E\u65B9\u91DD\u304C\u6C7A\u307E\u3063\u305F\u5834\u9762"
      question1: "\u6C7A\u307E\u3063\u305F\u3053\u3068\u3060\u304B\u3089\u4ED5\u65B9\u306A\u3044\u3068\u5272\u308A\u5207\u3063\u3066\u3001\n\u6307\u793A\u901A\u308A\u306B\u3084\u308B"
      question2: "\u300C\u304A\u5BA2\u3055\u3093\u3092\u9A19\u3059\u3088\u3046\u306A\u771F\u4F3C\u306F\u30C0\u30E1\u3060\u300D\u3068\u4E0A\u53F8\u306B\u53CD\u5BFE\u3059\u308B"
      question3: "\u5BA2\u306B\u5206\u304B\u308B\u3088\u3046\u306B\u3001\u6B63\u76F4\u306B\u8AAC\u660E\u3057\u3066\u304B\u3089\u51FA\u3059"

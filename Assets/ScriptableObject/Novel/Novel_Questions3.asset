      situation: "\u8077\u5834\u3002\u5927\u4E8B\u306A\u4F1A\u8B70\u3067\u8AB0\u3082\u767A\u8A00\u305B\u305A\u3001\u6C17\u307E\u305A\u3044\u6C88\u9ED9\u304C\u6D41\u308C\u3066\u3044\u308B\u5834\u9762"
      question1: "\u3068\u308A\u3042\u3048\u305A\u5834\u3092\u52D5\u304B\u3059\u305F\u3081\u306B\u3001\n\u601D\u3044\u3064\u304D\u3067\u3082\u81EA\u5206\u306E\u610F\u898B\u3092\u8A00\u3046"
      question2: "\u8AB0\u304B\u304C\u8A71\u3059\u304B\u3001\u6307\u540D\u3055\u308C\u308B\u307E\u3067\u3058\u3063\u3068\u9ED9\u3063\u3066\u3044\u308B"
      question3: "\u307F\u3093\u306A\u304C\u8A71\u3057\u3084\u3059\u3044\u3088\u3046\u306B\u300C\u3007\u3007\u3055\u3093\u306F\u3069\u3046\u601D\u3044\u307E\u3059\uFF1F\u300D\n\u3068\u632F\u3063\u3066\u307F\u308B"

    storyText: "\u541B\u304C\u4ECA\u307E\u3067\u3067\u4E00\u756A\u300C\u5272\u306B\u5408\u308F\u306A\u3044\u300D\u3068\u601D\u3063\u305F\n\u4ED5\u4E8B\u3084\u5F79\u5272\u306F\u306A\u3093\u3060\u3044\uFF1F\n\u305D\u308C\u3067\u3082\u7D9A\u3051\u305F\u306E\u304B\u3001\u3084\u3081\u305F\u306E\u304B\u3082\u6559\u3048\u3066\u304F\u308C"

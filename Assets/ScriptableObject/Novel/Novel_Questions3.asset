    storyText: "\u7DE0\u5207\u30AE\u30EA\u30AE\u30EA\u3067\u4ED5\u4E8B\u304C\u5B8C\u6210\u3057\u305F\u3051\u3069\u3001\n\u3082\u3063\u3068\u826F\u304F\u3067\u304D\u308B\u30A2\u30A4\u30C7\u30A2\u3092\u601D\u3044\u3064\u3044\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u8077\u5834\u3002\u7DE0\u5207\u30AE\u30EA\u30AE\u30EA\u3067\u4ED5\u4E8B\u304C\u5B8C\u6210\u3057\u305F\u5F8C\u306B\u3001\u3082\u3063\u3068\u826F\u304F\u3067\u304D\u308B\u30A2\u30A4\u30C7\u30A2\u3092\u601D\u3044\u3064\u3044\u305F\u5834\u9762"
      question1: "\u7DE0\u5207\u3092\u5B88\u308B\u306E\u304C\u4E00\u756A\u5927\u4E8B\u306A\u306E\u3067\u3001\u305D\u306E\u307E\u307E\u63D0\u51FA\u3059\u308B"
      question2: "\u63D0\u51FA\u304C\u9045\u308C\u308B\u30EA\u30B9\u30AF\u304C\u3042\u3063\u3066\u3082\u3001\n\u30AE\u30EA\u30AE\u30EA\u307E\u3067\u7C98\u3063\u3066\u30AF\u30AA\u30EA\u30C6\u30A3\u3092\u4E0A\u3052\u308B"

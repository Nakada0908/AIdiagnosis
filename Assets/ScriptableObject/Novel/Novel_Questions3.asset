    - {fileID: 0}
    storyText: "\u81EA\u5206\u306E\u30DF\u30B9\u3092\u3001\u306A\u305C\u304B\u5F8C\u8F29\u304C\u304B\u3076\u3063\u3066\n\u8B1D\u3063\u3066\u3057\u307E\u3063\u305F\u3002\u305D\u306E\u5834\u306F\u3082\u3046\u53CE\u307E\u3063\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u8077\u5834\u3002\u81EA\u5206\u306E\u30DF\u30B9\u3092\u5F8C\u8F29\u304C\u304B\u3076\u3063\u3066\u8B1D\u3063\u3066\u3057\u307E\u3044\u3001\u305D\u306E\u5834\u306F\u3082\u3046\u53CE\u307E\u3063\u3066\u3044\u308B\u5834\u9762"
      question1: "\u4ECA\u3059\u3050\u8A02\u6B63\u3059\u308B\u3002\u5F8C\u8F29\u306B\u6065\u306F\u304B\u304B\u305B\u306A\u3044"

    - {fileID: 0}
    storyText: "\u6821\u5247\u3067\u7981\u6B62\u3055\u308C\u3066\u3044\u308B\u6821\u5916\u30A2\u30EB\u30D0\u30A4\u30C8\u306B\u3001\n\u53CB\u9054\u304B\u3089\u300C\u4E00\u7DD2\u306B\u3084\u308D\u3046\u300D\u3068\u8A98\u308F\u308C\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      question1: "\u898B\u3064\u304B\u3063\u305F\u30EA\u30B9\u30AF\u304C\u5927\u304D\u3044\u306E\u3067\u3001\u30AD\u30C3\u30D1\u30EA\u65AD\u308B"
      question2: "\u7D76\u5BFE\u306B\u5B66\u6821\u306B\u30D0\u30EC\u306A\u3044\u65B9\u6CD5\u3084\n\u8A00\u3044\u8A33\u3092\u3057\u3063\u304B\u308A\u8003\u3048\u3066\u304B\u3089\u3084\u308B"

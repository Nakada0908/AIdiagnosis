  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u30C6\u30B9\u30C8\u4E2D\u3001\u96A3\u306E\u5E2D\u306E\u53CB\u9054\u304C\u30B9\u30DE\u30DB\u3067\u30AB\u30F3\u30CB\u30F3\u30B0\u3057\u3066\u3044\u308B\u306E\u3092\u898B\u3064\u3051\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      question1: "\u5E73\u7B49\u3058\u3083\u306A\u3044\u306E\u3067\u3001\u3059\u3050\u306B\u5148\u751F\u306B\u30B3\u30C3\u30BD\u30EA\u6559\u3048\u308B"
      question2: "\u53CB\u9054\u3068\u306E\u4EF2\u304C\u58CA\u308C\u308B\u306E\u304C\u5ACC\u306A\u306E\u3067\u3001\u898B\u306A\u304B\u3063\u305F\u3053\u3068\u306B\u3059\u308B"
      question3: "\u30C6\u30B9\u30C8\u304C\u7D42\u308F\u3063\u305F\u3042\u3068\u3001\n\u53CB\u9054\u306B\u300C\u306A\u3093\u3067\u3042\u3093\u306A\u3053\u3068\u3057\u305F\u306E\uFF1F\u300D\u3068\u805E\u304F"
      choiceNum: 1
      answer: 
      answerTime: 1.4270496
    voiceClip: {fileID: 0}
    seClip: {fileID: 0}
  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u6587\u5316\u796D\u306E\u51FA\u3057\u7269\u3092\u6C7A\u3081\u308B\u8A71\u3057\u5408\u3044\u304C\u3001\u5168\u7136\u307E\u3068\u307E\u3089\u306A\u3044\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      question1: "\u78BA\u5B9F\u306B\u6210\u529F\u3057\u305D\u3046\u306A\u3001\u5B9A\u756A\u3067\u5B89\u5168\u306A\u4F01\u753B\u3092\u63D0\u6848\u3059\u308B"
      question2: "\u5931\u6557\u3059\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3051\u3069\u3001\n\u8AB0\u3082\u3084\u3063\u305F\u3053\u3068\u304C\u306A\u3044\u9762\u767D\u3044\u4F01\u753B\u3092\u63D0\u6848\u3059\u308B"
      question3: "\u81EA\u5206\u304B\u3089\u306F\u610F\u898B\u3092\u51FA\u3055\u305A\u3001\u30AF\u30E9\u30B9\u306E\u591A\u6570\u6C7A\u306B\u4EFB\u305B\u308B"
      choiceNum: 3
      answer: 
      answerTime: 0.0429903
    voiceClip: {fileID: 0}
    seClip: {fileID: 0}
  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u90E8\u6D3B\u3067\u3001\u8A66\u5408\u306B\u51FA\u308B\u30EC\u30AE\u30E5\u30E9\u30FC\u3092\u6C7A\u3081\u308B\u6A29\u5229\u3092\u4EFB\u3055\u308C\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      question1: "\u3053\u308C\u307E\u3067\u306E\u30BF\u30A4\u30E0\u3084\u30C6\u30B9\u30C8\u306E\u6210\u7E3E\u306A\u3069\u3001\n\u5BA2\u89B3\u7684\u306A\u30C7\u30FC\u30BF\u3067\u5B9F\u529B\u9806\u306B\u9078\u3076"
      question2: "\u3053\u308C\u307E\u3067\u306E\u52AA\u529B\u3084\u3001\n\u6700\u5F8C\u306E\u8A66\u5408\u306B\u306A\u308B\u5148\u8F29\u305F\u3061\u306E\u6C17\u6301\u3061\u3092\u512A\u5148\u3057\u3066\u9078\u3076"
      question3: "\u81EA\u5206\u3067\u6C7A\u3081\u308B\u306E\u306F\u8377\u91CD\u304C\u91CD\u3044\u306E\u3067\u3001\n\u9867\u554F\u306E\u5148\u751F\u306B\u4E38\u6295\u3052\u3059\u308B"
      choiceNum: 1

    storyText: "\u65B0\u3057\u3044\u5B66\u6821\u3084\u30AF\u30E9\u30B9\u306B\u5165\u3063\u305F\u3068\u304D\u3001\n\u307F\u3093\u306A\u304B\u3089\u300E\u3053\u306E\u4EBA\u3001\u4FE1\u983C\u3067\u304D\u308B\u306A\u300F\u3068\u601D\u308F\u308C\u308B\u305F\u3081\u306B\u3001\n\u4E00\u756A\u5927\u5207\u3060\u3068\u601D\u3046\u884C\u52D5\u306F\u306A\u3093\u3060\u3044\uFF1F\u7406\u7531\u3082\u4E00\u7DD2\u983C\u3080\u3088"

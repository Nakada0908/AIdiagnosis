  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u89AA\u3084\u5148\u751F\u304B\u3089\u300C\u7D76\u5BFE\u306B\u53D7\u304B\u308B\u3001\u5B89\u5168\u3067\u5805\u5B9F\u306A\u9032\u8DEF\u300D\u3092\u5F37\u304F\u52E7\u3081\u3089\u308C\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      question1: "\u5468\u308A\u306E\u610F\u898B\u3092\u805E\u3044\u3066\u3001\u5B89\u5168\u3067\u78BA\u5B9F\u306A\u9053\u3092\u9078\u3076"
      question2: "\u5931\u6557\u3059\u308B\u30EA\u30B9\u30AF\u304C\u3042\u3063\u3066\u3082\u3001\n\u81EA\u5206\u304C\u672C\u5F53\u306B\u3084\u308A\u305F\u3044\u5922\u306E\u9053\u3092\u9078\u3076"
      question3: "\u5B89\u5168\u306A\u9053\u3092\u9032\u307F\u3064\u3064\u3001\u5922\u3082\u8AE6\u3081\u306A\u3044\u65B9\u6CD5\u3092\u5FC5\u6B7B\u3067\u63A2\u3059"
      choiceNum: 2

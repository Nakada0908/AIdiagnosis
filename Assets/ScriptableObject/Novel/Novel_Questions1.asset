  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u8AB0\u3082\u3044\u306A\u3044\u653E\u8AB2\u5F8C\u306E\u6559\u5BA4\u3067\u3001\u304A\u672D\u304C\u5165\u3063\u305F\u8CA1\u5E03\u304C\u843D\u3061\u3066\u3044\u308B\u306E\u3092\u898B\u3064\u3051\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      question1: "\u4E2D\u8EAB\u306B\u306F\u89E6\u3089\u305A\u3001\u305D\u306E\u307E\u307E\u8077\u54E1\u5BA4\u3078\u5C4A\u3051\u308B"
      question2: "\u751F\u5F92\u8A3C\u3060\u3051\u78BA\u8A8D\u3057\u3066\u843D\u3068\u3057\u4E3B\u3092\u7279\u5B9A\u3057\u3001\n\u8CA1\u5E03\u306F\u5143\u306E\u5834\u6240\u306B\u7F6E\u3044\u3066\u304A\u304F"
      question3: "\u8AB0\u3082\u898B\u3066\u3044\u306A\u3044\u306A\u3089\u3001\u305D\u306E\u307E\u307E\u81EA\u5206\u306E\u30DD\u30B1\u30C3\u30C8\u306B\u5165\u308C\u308B"
      choiceNum: 2

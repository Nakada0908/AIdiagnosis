    - {fileID: 0}
    storyText: "\u6821\u820E\u306E\u88CF\u3067\u3001\u540C\u7D1A\u751F\u304C\u3044\u3058\u3081\u3089\u308C\u3066\u3044\u308B\u306E\u3092\u898B\u304B\u3051\u3066\u3057\u307E\u3063\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      question1: "\u81EA\u5206\u304C\u5DFB\u304D\u8FBC\u307E\u308C\u308B\u30EA\u30B9\u30AF\u3092\u899A\u609F\u3067\u3001\u76F4\u63A5\u52A9\u3051\u306B\u5165\u308B"
      question2: "\u76F4\u63A5\u5165\u308B\u306E\u306F\u5371\u967A\u306A\u306E\u3067\u3001\n\u52D5\u753B\u3084\u5199\u771F\u3092\u64AE\u3063\u3066\u533F\u540D\u3067\u8B66\u5BDF\u3084\u5B66\u6821\u306B\u901A\u5831\u3059\u308B"
      question3: "\u81EA\u5206\u306B\u88AB\u5BB3\u304C\u53CA\u3076\u3068\u5ACC\u306A\u306E\u3067\u3001\u898B\u306A\u304B\u3063\u305F\u3053\u3068\u306B\u3057\u3066\u53BB\u308B"
      choiceNum: 3

  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u8FFD\u308F\u308C\u305F\u5B50\u3069\u3082\u3092\u533F\u3063\u305F\u304C\u3001\n\u305D\u306E\u5B50\u306F\u76D7\u307F\u3092\u50CD\u3044\u3066\u3044\u305F\u3089\u3057\u3044\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u8FFD\u308F\u308C\u305F\u5B50\u3069\u3082\u3092\u533F\u3063\u305F\u304C\u3001\u305D\u306E\u5B50\u306F\u76D7\u307F\u3092\u50CD\u3044\u3066\u3044\u305F\u3089\u3057\u3044\u3068\u5206\u304B\u3063\u305F\u5834\u9762"
      question1: "\u4E8B\u60C5\u3092\u78BA\u304B\u3081\u3066\u304B\u3089\u3001\u3069\u3046\u3059\u308B\u304B\u6C7A\u3081\u308B"
      question2: "\u5B50\u3069\u3082\u3060\u3002\u3068\u306B\u304B\u304F\u5148\u306B\u9003\u304C\u3059"
      question3: "\u76D7\u307F\u306F\u76D7\u307F\u3060\u3002\u8FFD\u3063\u624B\u306B\u5F15\u304D\u6E21\u3059"

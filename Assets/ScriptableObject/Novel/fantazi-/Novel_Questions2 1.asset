    - {fileID: 0}
    storyText: "\u8857\u306E\u9580\u3067\u3001\u507D\u7269\u306E\u8EAB\u5206\u8A3C\u3092\u4F7F\u3063\u3066\n\u30B3\u30C3\u30BD\u30EA\u5165\u308D\u3046\u3068\u3057\u3066\u3044\u308B\u96E3\u6C11\u3092\u898B\u3064\u3051\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u8857\u306E\u9580\u3067\u507D\u306E\u8EAB\u5206\u8A3C\u3092\u4F7F\u3063\u3066\u5165\u308D\u3046\u3068\u3057\u3066\u3044\u308B\u96E3\u6C11\u3092\u898B\u3064\u3051\u305F\u5834\u9762"
      question1: "\u8857\u306E\u30EB\u30FC\u30EB\u3092\u5B88\u308B\u305F\u3081\u3001\u3059\u3050\u306B\u8B66\u5099\u5175\u306B\u901A\u5831\u3059\u308B"
      question2: "\u53EF\u54C0\u60F3\u306A\u306E\u3067\u3001\u898B\u9003\u3057\u3066\u8857\u306B\u5165\u308B\u306E\u3092\u624B\u4F1D\u3063\u3066\u3042\u3052\u308B"
      question3: "\u901A\u5831\u3059\u308B\u524D\u306B\u300C\u306A\u305C\u305D\u3093\u306A\u3053\u3068\u3057\u3066\u307E\u3067\n\u5165\u308D\u3046\u3068\u3057\u3066\u308B\u306E\uFF1F\u300D\u3068\u4E8B\u60C5\u3092\u805E\u304F"
      choiceNum: 0
      answer: 
      answerTime: 0
    voiceClip: {fileID: 0}
    seClip: {fileID: 0}
  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u753A\u306E\u9580\u3067\u901A\u884C\u7A0E\u3092\u53D6\u3089\u308C\u305F\u3002\u76F8\u5834\u306E\u5341\u500D\u3060\u3002\n\u6255\u308F\u306A\u3044\u3068\u3001\u4E2D\u306B\u306F\u5165\u308C\u306A\u3044\u3089\u3057\u3044\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u753A\u306E\u9580\u3067\u76F8\u5834\u306E\u5341\u500D\u306E\u901A\u884C\u7A0E\u3092\u53D6\u3089\u308C\u3001\u6255\u308F\u306A\u3044\u3068\u4E2D\u306B\u5165\u308C\u306A\u3044\u3068\u8A00\u308F\u308C\u305F\u5834\u9762"
      question1: "\u9AD8\u3044\u304C\u3001\u6255\u3063\u3066\u6B63\u9762\u304B\u3089\u5165\u308B"
      question2: "\u9AD8\u3059\u304E\u308B\u3002\u53D6\u308A\u6C7A\u3081\u3092\u898B\u305B\u308D\u3068\u639B\u3051\u5408\u3046"
      question3: "\u6255\u308F\u306A\u3044\u3002\u8AB0\u3082\u898B\u3066\u3044\u306A\u3044\u9053\u3092\u63A2\u3059"

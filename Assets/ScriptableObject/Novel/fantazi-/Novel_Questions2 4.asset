    storyText: "\u6FC0\u3057\u3044\u6226\u3044\u306E\u672B\u3001\u6575\u306E\u30DC\u30B9\u304C\u300C\u52A9\u3051\u3066\u304F\u308C\uFF01\u300D\u3068\u547D\u4E5E\u3044\u3092\u3057\u3066\u304D\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u6FC0\u3057\u3044\u6226\u3044\u306E\u672B\u3001\u6575\u306E\u30DC\u30B9\u304C\u547D\u4E5E\u3044\u3092\u3057\u3066\u304D\u305F\u5834\u9762"
      question1: "\u751F\u304B\u3057\u3066\u304A\u304F\u5371\u967A\u304C\u3042\u308B\u3002\u3053\u3053\u3067\u7D42\u308F\u3089\u305B\u308B"
      question2: "\u6B66\u5668\u3092\u6368\u3066\u3055\u305B\u3066\u3001\u8857\u306E\u7262\u306B\u5F15\u304D\u6E21\u3059"

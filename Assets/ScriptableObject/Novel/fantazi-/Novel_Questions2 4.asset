    storyText: "\u6226\u3044\u306E\u6700\u4E2D\u3001\u4EF2\u9593\u306E\u30DF\u30B9\u3067\u30D1\u30FC\u30C6\u30A3\u30FC\u5168\u54E1\u304C\u30D4\u30F3\u30C1\u306B\u306A\u3063\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u6226\u95D8\u4E2D\u306B\u4EF2\u9593\u306E\u30DF\u30B9\u3067\u30D1\u30FC\u30C6\u30A3\u30FC\u5168\u54E1\u304C\u30D4\u30F3\u30C1\u306B\u306A\u3063\u305F\u5834\u9762"
      question1: "\u306A\u3093\u3067\u305D\u3093\u306A\u30DF\u30B9\u3092\u3057\u305F\u306E\u304B\u3001\n\u3042\u3068\u3067\u3057\u3063\u304B\u308A\u539F\u56E0\u3092\u8FFD\u53CA\u3059\u308B"
      question2: "\u300C\u843D\u3061\u8FBC\u307E\u306A\u3044\u3067\u300D\u3068\u52B1\u307E\u3057\u3066\u3001\n\u30C1\u30FC\u30E0\u306E\u96F0\u56F2\u6C17\u3092\u58CA\u3055\u306A\u3044\u3088\u3046\u306B\u3059\u308B"
      question3: "\u4F55\u3082\u8A00\u308F\u305A\u3001\u81EA\u5206\u304C\u4F53\u3092\u5F35\u3063\u3066\u30D4\u30F3\u30C1\u3092\u5207\u308A\u629C\u3051\u308B"

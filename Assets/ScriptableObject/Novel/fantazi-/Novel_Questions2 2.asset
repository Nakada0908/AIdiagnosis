  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u4F9D\u983C\u4EBA\u304B\u3089\u300C\u7D76\u5BFE\u306B\u4E2D\u8EAB\u3092\u898B\u308B\u306A\u300D\u3068\u8A00\u308F\u308C\u305F\u624B\u7D19\u3092\u9810\u304B\u3063\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u4F9D\u983C\u4EBA\u304B\u3089\u4E2D\u8EAB\u3092\u898B\u308B\u306A\u3068\u8A00\u308F\u308C\u305F\u624B\u7D19\u3092\u9810\u304B\u3063\u305F\u5834\u9762"
      question1: "\u7D04\u675F\u3092\u5B88\u3063\u3066\u3001\u898B\u305A\u306B\u76EE\u7684\u5730\u307E\u3067\u5C4A\u3051\u308B"
      question2: "\u3053\u3063\u305D\u308A\u8AAD\u3093\u3067\u304B\u3089\u3001\u4F55\u98DF\u308F\u306C\u9854\u3067\u5C4A\u3051\u308B"
      question3: "\u4F9D\u983C\u4EBA\u306B\u300C\u4F55\u304C\u5165\u3063\u3066\u308B\u306E\uFF1F\u300D\u3068\u805E\u304D\u8FD4\u3059"

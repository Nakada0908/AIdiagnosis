    storyText: "\u5192\u967A\u8005\u30AE\u30EB\u30C9\u306E\u63B2\u793A\u677F\u3067\u3001\u53D7\u3051\u308B\u4ED5\u4E8B\u30921\u3064\u9078\u3076\u306A\u3089\uFF1F"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u5192\u967A\u8005\u30AE\u30EB\u30C9\u306E\u63B2\u793A\u677F\u304B\u3089\u53D7\u3051\u308B\u4ED5\u4E8B\u3092\u4E00\u3064\u9078\u3076\u5834\u9762"
      question1: "\u5831\u916C\u306F\u3081\u3061\u3083\u304F\u3061\u3083\u5B89\u3044\u3051\u3069\u3001\n\u56F0\u3063\u3066\u3044\u308B\u6751\u4EBA\u3092\u78BA\u5B9F\u306B\u52A9\u3051\u3089\u308C\u308B\u4ED5\u4E8B"
      question2: "\u6B7B\u306C\u307B\u3069\u5371\u967A\u3060\u3051\u3069\u3001\u6210\u529F\u3059\u308C\u3070\u5927\u91D1\u6301\u3061\u306B\u306A\u308C\u308B\u4ED5\u4E8B"
      question3: "\u8AB0\u4E00\u4EBA\u3068\u3057\u3066\u6210\u529F\u3057\u305F\u3053\u3068\u304C\u306A\u3044\u3001\n\u672A\u77E5\u306E\u30C0\u30F3\u30B8\u30E7\u30F3\u3092\u8ABF\u3079\u308B\u4ED5\u4E8B"
      choiceNum: 0

    storyText: "\u7121\u80FD\u6271\u3044\u3055\u308C\u3066\u3044\u305F\u304C\u3001\u5B9F\u306F\u6700\u5F37\u3060\u3063\u305F\n\u672C\u5F53\u306B\u7121\u80FD\u3060\u304C\u8FFD\u653E\u3055\u308C\u3066\u5439\u3063\u5207\u308C\u305F\u3053\u3068\u3067\u5F37\u304F\u306A\u308B\n\u2026\u2026\u306A\u3093\u3066\u3044\u308D\u3044\u308D\u3042\u308B\u306D"

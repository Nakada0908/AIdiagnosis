    storyText: "\u9053\u7AEF\u3067\u3001\u77E5\u3089\u306A\u3044\u884C\u5546\u4EBA\u304C\u5927\u30B1\u30AC\u3092\u3057\u3066\u5012\u308C\u3066\u3044\u308B\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u7570\u4E16\u754C\u3002\u9053\u7AEF\u3067\u898B\u77E5\u3089\u306C\u884C\u5546\u4EBA\u304C\u5927\u30B1\u30AC\u3092\u3057\u3066\u5012\u308C\u3066\u3044\u308B\u5834\u9762"
      question1: "\u81EA\u5206\u304C\u6301\u3063\u3066\u3044\u308B\u4E00\u756A\u3044\u3044\u56DE\u5FA9\u85AC\u3092\u3042\u3052\u3066\u52A9\u3051\u308B"
      question2: "\u76D7\u8CCA\u306E\u7F60\u304B\u3082\u3057\u308C\u306A\u3044\u306E\u3067\u3001\u8B66\u6212\u3057\u3066\u901A\u308A\u904E\u304E\u308B"
      question3: "\u300C\u52A9\u3051\u3066\u307B\u3057\u3051\u308C\u3070\u3001\u6301\u3063\u3066\u3044\u308B\u304A\u5B9D\u3092\u9802\u6234\u300D\n\u3068\u6761\u4EF6\u3092\u51FA\u3059"

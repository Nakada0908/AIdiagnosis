    storyText: "\u3059\u3054\u304F\u5F37\u3044\u6B66\u5668\u3092\u62FE\u3063\u305F\u3051\u3069\u3001\u5143\u306E\u6301\u3061\u4E3B\u304C\u6CE3\u304D\u306A\u304C\u3089\u63A2\u3057\u3066\u3044\u308B\u3002"

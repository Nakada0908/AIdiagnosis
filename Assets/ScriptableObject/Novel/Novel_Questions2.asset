    diagnosis:
      question1: "\u8857\u306E\u30EB\u30FC\u30EB\u3092\u5B88\u308B\u305F\u3081\u3001\u3059\u3050\u306B\u8B66\u5099\u5175\u306B\u901A\u5831\u3059\u308B"

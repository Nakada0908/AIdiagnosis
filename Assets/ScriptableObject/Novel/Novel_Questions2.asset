    storyText: "\u3053\u306E\u5148\u3069\u3063\u3061\u306E\u9053\u306B\u9032\u3080\u304B\u3067\u3001\u4EF2\u9593\u3068\u610F\u898B\u304C\u534A\u5206\u306B\u5272\u308C\u3066\u63C9\u3081\u3066\u3044\u308B\u3002"

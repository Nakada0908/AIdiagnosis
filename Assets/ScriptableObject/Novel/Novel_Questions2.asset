    storyText: "\u6FC0\u3057\u3044\u6226\u3044\u306E\u672B\u3001\u6575\u306E\u30DC\u30B9\u304C\u300C\u52A9\u3051\u3066\u304F\u308C\uFF01\u300D\u3068\u547D\u4E5E\u3044\u3092\u3057\u3066\u304D\u305F\u3002"
    characterName: 

    diagnosis:
      question1: "\u5831\u916C\u306F\u3081\u3061\u3083\u304F\u3061\u3083\u5B89\u3044\u3051\u3069\u3001\n\u56F0\u3063\u3066\u3044\u308B\u6751\u4EBA\u3092\u78BA\u5B9F\u306B\u52A9\u3051\u3089\u308C\u308B\u4ED5\u4E8B"

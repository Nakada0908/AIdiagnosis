  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u6587\u5316\u796D\u306E\u51FA\u3057\u7269\u3092\u6C7A\u3081\u308B\u8A71\u3057\u5408\u3044\u304C\u3001\u5168\u7136\u307E\u3068\u307E\u3089\u306A\u3044\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u5B66\u5712\u3002\u6587\u5316\u796D\u306E\u51FA\u3057\u7269\u3092\u6C7A\u3081\u308B\u8A71\u3057\u5408\u3044\u304C\u307E\u3068\u307E\u3089\u306A\u3044\u5834\u9762"
      question1: "\u78BA\u5B9F\u306B\u6210\u529F\u3057\u305D\u3046\u306A\u3001\u5B9A\u756A\u3067\u5B89\u5168\u306A\u4F01\u753B\u3092\u63D0\u6848\u3059\u308B"
      question2: "\u5931\u6557\u3059\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3051\u3069\u3001\n\u8AB0\u3082\u3084\u3063\u305F\u3053\u3068\u304C\u306A\u3044\u9762\u767D\u3044\u4F01\u753B\u3092\u63D0\u6848\u3059\u308B"
      question3: "\u81EA\u5206\u304B\u3089\u306F\u610F\u898B\u3092\u51FA\u3055\u305A\u3001\u30AF\u30E9\u30B9\u306E\u591A\u6570\u6C7A\u306B\u4EFB\u305B\u308B"

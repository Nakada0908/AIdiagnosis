    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u5148\u751F\u304B\u3089\u5168\u304F\u8EAB\u306B\u899A\u3048\u306E\u306A\u3044\u6821\u5247\u9055\u53CD\u3092\u7591\u308F\u308C\u3066\u3001\u6012\u3089\u308C\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u5B66\u5712\u3002\u8EAB\u306B\u899A\u3048\u306E\u306A\u3044\u6821\u5247\u9055\u53CD\u3092\u5148\u751F\u306B\u7591\u308F\u308C\u3066\u6012\u3089\u308C\u3066\u3044\u308B\u5834\u9762"
      question1: "\u81EA\u5206\u306E\u884C\u52D5\u3092\u9806\u756A\u306B\u8AAC\u660E\u3057\u3066\u3001\n\u9593\u9055\u3063\u3066\u3044\u306A\u3044\u3068\u8AD6\u7406\u7684\u306B\u53CD\u8AD6\u3059\u308B"
      question2: "\u7406\u4E0D\u5C3D\u3059\u304E\u3066\u982D\u306B\u304D\u305F\u306E\u3067\u3001\n\u611F\u60C5\u3092\u9732\u308F\u306B\u3057\u3066\u305D\u306E\u5834\u3092\u7ACB\u3061\u53BB\u308B"
      question3: "\u9762\u5012\u306A\u4E8B\u306B\u3057\u305F\u304F\u306A\u3044\u306E\u3067\u3001\n\u3068\u308A\u3042\u3048\u305A\u8A00\u308F\u308C\u305F\u901A\u308A\u306B\u3057\u3066\u304A\u304F"
      choiceNum: 0
      answer: 
      answerTime: 0
    voiceClip: {fileID: 0}
    seClip: {fileID: 0}
  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u30C6\u30B9\u30C8\u4E2D\u3001\u96A3\u306E\u5E2D\u306E\u53CB\u9054\u304C\u30B9\u30DE\u30DB\u3067\u30AB\u30F3\u30CB\u30F3\u30B0\u3057\u3066\u3044\u308B\u306E\u3092\u898B\u3064\u3051\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u5B66\u5712\u3002\u30C6\u30B9\u30C8\u4E2D\u306B\u96A3\u306E\u5E2D\u306E\u53CB\u9054\u304C\u30B9\u30DE\u30DB\u3067\u30AB\u30F3\u30CB\u30F3\u30B0\u3057\u3066\u3044\u308B\u306E\u3092\u898B\u3064\u3051\u305F\u5834\u9762"
      question1: "\u5E73\u7B49\u3058\u3083\u306A\u3044\u306E\u3067\u3001\u3059\u3050\u306B\u5148\u751F\u306B\u30B3\u30C3\u30BD\u30EA\u6559\u3048\u308B"
      question2: "\u53CB\u9054\u3068\u306E\u4EF2\u304C\u58CA\u308C\u308B\u306E\u304C\u5ACC\u306A\u306E\u3067\u3001\u898B\u306A\u304B\u3063\u305F\u3053\u3068\u306B\u3059\u308B"
      question3: "\u30C6\u30B9\u30C8\u304C\u7D42\u308F\u3063\u305F\u3042\u3068\u3001\n\u53CB\u9054\u306B\u300C\u306A\u3093\u3067\u3042\u3093\u306A\u3053\u3068\u3057\u305F\u306E\uFF1F\u300D\u3068\u805E\u304F"
      choiceNum: 0
      answer: 
      answerTime: 0
    voiceClip: {fileID: 0}

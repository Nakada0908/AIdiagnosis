    storyText: "\u53CB\u9054\u306B\u501F\u308A\u305F\u30B2\u30FC\u30E0\u6A5F\u3092\u3001\n\u843D\u3068\u3057\u3066\u50B7\u3064\u3051\u3066\u3057\u307E\u3063\u305F\u3002"

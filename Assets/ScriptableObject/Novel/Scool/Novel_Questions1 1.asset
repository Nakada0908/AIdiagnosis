    storyText: "\u89AA\u3084\u5148\u751F\u304B\u3089\u300C\u7D76\u5BFE\u306B\u53D7\u304B\u308B\u3001\u5B89\u5168\u3067\u5805\u5B9F\u306A\u9032\u8DEF\u300D\u3092\u5F37\u304F\u52E7\u3081\u3089\u308C\u305F\u3002"
    characterName: 

  - characterImage:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
    storyText: "\u8AB0\u3082\u3044\u306A\u3044\u6559\u5BA4\u3067\u8CA1\u5E03\u3092\u62FE\u3063\u305F\u3002\n\u4E2D\u306E\u751F\u5F92\u8A3C\u306F\u3001\u81EA\u5206\u3092\u305A\u3063\u3068\u907F\u3051\u3066\u3044\u308B\n\u30AF\u30E9\u30B9\u30E1\u30A4\u30C8\u306E\u3082\u306E\u3060\u3063\u305F\u3002"
    characterName: 
    storyType: 1
    diagnosis:
      situation: "\u5B66\u5712\u3002\u8AB0\u3082\u3044\u306A\u3044\u6559\u5BA4\u3067\u8CA1\u5E03\u3092\u62FE\u3044\u3001\u305D\u308C\u304C\u81EA\u5206\u3092\u907F\u3051\u3066\u3044\u308B\u30AF\u30E9\u30B9\u30E1\u30A4\u30C8\u306E\u3082\u306E\u3060\u3068\u5206\u304B\u3063\u305F\u5834\u9762"
      question1: "\u8AB0\u306E\u3082\u306E\u3067\u3082\u540C\u3058\u3060\u3002\u8077\u54E1\u5BA4\u3078\u5C4A\u3051\u308B"
      question2: "\u898B\u306A\u304B\u3063\u305F\u3053\u3068\u306B\u3057\u3066\u3001\u5143\u306E\u5834\u6240\u306B\u623B\u3059"

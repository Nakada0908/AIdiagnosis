    diagnosis:
      situation: "\u5B66\u5712\u3002\u89AA\u3084\u5148\u751F\u304B\u3089\u5B89\u5168\u3067\u5805\u5B9F\u306A\u9032\u8DEF\u3092\u5F37\u304F\u52E7\u3081\u3089\u308C\u3066\u3044\u308B\u5834\u9762"
      question1: "\u52E7\u3081\u3089\u308C\u305F\u901A\u308A\u306B\u3059\u308B\u3002\u7406\u7531\u3082\u7D0D\u5F97\u3067\u304D\u308B"
      question2: "\u81EA\u5206\u306E\u5E0C\u671B\u3092\u901A\u3059\u3002\u8CAC\u4EFB\u306F\u81EA\u5206\u3067\u53D6\u308B"
      question3: "\u4E00\u5EA6\u305D\u306E\u901A\u308A\u306B\u3057\u3066\u3001\u3042\u3068\u3067\u5909\u3048\u308B\u3064\u3082\u308A\u3067\u3044\u308B"

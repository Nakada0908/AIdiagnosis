    diagnosis:
      situation: "\u5B66\u5712\u3002\u90E8\u6D3B\u3067\u8A66\u5408\u306B\u51FA\u308B\u30EC\u30AE\u30E5\u30E9\u30FC\u3092\u6C7A\u3081\u308B\u6A29\u5229\u3092\u4EFB\u3055\u308C\u305F\u5834\u9762"
      question1: "\u3053\u308C\u307E\u3067\u306E\u30BF\u30A4\u30E0\u3084\u30C6\u30B9\u30C8\u306E\u6210\u7E3E\u306A\u3069\u3001\n\u5BA2\u89B3\u7684\u306A\u30C7\u30FC\u30BF\u3067\u5B9F\u529B\u9806\u306B\u9078\u3076"
      question2: "\u3053\u308C\u307E\u3067\u306E\u52AA\u529B\u3084\u3001\n\u6700\u5F8C\u306E\u8A66\u5408\u306B\u306A\u308B\u5148\u8F29\u305F\u3061\u306E\u6C17\u6301\u3061\u3092\u512A\u5148\u3057\u3066\u9078\u3076"
      question3: "\u81EA\u5206\u3067\u6C7A\u3081\u308B\u306E\u306F\u8377\u304C\u91CD\u3044\u306E\u3067\u3001\n\u9867\u554F\u306E\u5148\u751F\u306B\u4E38\u6295\u3052\u3059\u308B"

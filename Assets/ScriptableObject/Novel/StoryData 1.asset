    diagnosis:
      question1: "\u6821\u5247\u3068\u81EA\u8EAB\u306E\u884C\u52D5\u8A18\u9332\u3092\u63D0\u793A\u3057\u3001\u8AD6\u7406\u7684\u306B\u7121\u5B9F\u3092\u8A3C\u660E\u3057\u3066\u53CD\u8AD6\u3059\u308B"
